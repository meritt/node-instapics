  "description": "Wrapper for the Instagram API",
  "keywords": [
    "graph-api",
    "instagram",
    "instagram-api",
    "instagram-login",
    "media",
    "photo",
    "reels"
  ],
  "license": "MIT",
  "author": {
    "name": "Alexey Simonenko",
    "email": "alexey@simonenko.dev",
    "url": "http://simonenko.xyz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meritt/node-instapics.git"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "exports": "./lib/index.js",
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt",
