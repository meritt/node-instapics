{
  "name": "instapics",
  "version": "1.0.0",
  "description": "Wrapper for the Instagram API",
  "keywords": [
    "graph-api",
    "instagram",
    "instagram-api",
    "instagram-login",
    "media",
    "photo",
    "reels"
  ],
  "license": "MIT",
  "author": {
    "name": "Alexey Simonenko",
    "email": "alexey@simonenko.dev",
    "url": "https://simonenko.xyz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meritt/node-instapics.git"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": "./lib/index.js",
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node --test test/*.js",
    "coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-lines=97 --test-coverage-branches=85 --test-coverage-functions=93 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info test/*.js"
  },
  "devDependencies": {
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.13.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.13"
  },
  "packageManager": "pnpm@12.16.1"
}
